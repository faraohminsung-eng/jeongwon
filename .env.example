# 이 파일을 복사해 .env 로 저장하고 실제 값을 입력하세요. (.env는 절대 git에 커밋하지 않습니다)

# PostgreSQL 접속 문자열 (Supabase/Neon/RDS 등 어떤 Postgres든 가능)
DATABASE_URL="postgresql://user:password@host:5432/hanok_garden_house?schema=public"

