# 이 파일을 복사해 .env 로 저장하고 실제 값을 입력하세요. (.env는 절대 git에 커밋하지 않습니다)

# PostgreSQL 접속 문자열 (Supabase/Neon/RDS 등 어떤 Postgres든 가능)
DATABASE_URL="postgresql://user:password@host:5432/hanok_garden_house?schema=public"

# 관리자 세션 쿠키 서명에 사용하는 비밀키 (반드시 무작위 긴 문자열로 직접 생성)
# 생성 예: openssl rand -hex 32
AUTH_SECRET="여기에-무작위로-생성한-긴-문자열을-넣으세요"

# 최초 관리자 계정을 만들 때 한 번만 사용하는 설정 토큰 (관리자가 1명이라도 생기면 더 이상 사용 불가)
ADMIN_SETUP_TOKEN="여기에-무작위-문자열을-넣으세요"

# ----- 다음 단계(카드결제)에서 사용할 예정인 값들 (아직 미사용) -----
# KAKAO_MAP_APP_KEY=
# NAVER_MAP_CLIENT_ID=
# PG_MERCHANT_ID=
# PG_SECRET_KEY=
