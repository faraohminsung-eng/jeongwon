# 이 파일을 복사해 .env 로 저장하고 실제 값을 입력하세요. (.env는 절대 git에 커밋하지 않습니다)

# PostgreSQL 접속 문자열 (Supabase/Neon/RDS 등 어떤 Postgres든 가능)
DATABASE_URL="postgresql://user:password@host:5432/hanok_garden_house?schema=public"

# 관리자 세션 쿠키 서명에 사용하는 비밀키 (반드시 무작위 긴 문자열로 직접 생성)
# 생성 예: openssl rand -hex 32
AUTH_SECRET="여기에-무작위로-생성한-긴-문자열을-넣으세요"

# 최초 관리자 계정을 만들 때 한 번만 사용하는 설정 토큰 (관리자가 1명이라도 생기면 더 이상 사용 불가)
ADMIN_SETUP_TOKEN="여기에-무작위-문자열을-넣으세요"

# ----- 카드결제 (토스페이먼츠) -----
# 아래는 토스페이먼츠가 공식 문서/샘플에서 공개적으로 제공하는 "테스트 전용" 키입니다.
# 회원가입 없이 결제 흐름을 테스트해볼 수 있지만, 실제 서비스(실결제)에는 사용할 수 없습니다.
# 실 서비스 전환 시 https://developers.tosspayments.com 에서 본인 계정으로 발급받은
# 키로 반드시 교체하세요 (클라이언트 키는 공개되어도 되지만, 시크릿 키는 절대 외부에 노출하지 마세요).
NEXT_PUBLIC_TOSS_CLIENT_KEY="test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq"
TOSS_SECRET_KEY="test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R"

# ----- 사진 업로드용 오브젝트 스토리지 (S3 호환: AWS S3 / Cloudflare R2 / Supabase Storage 등) -----
# 아래 값을 설정하지 않으면 로컬 디스크(public/uploads)에 저장됩니다.
# (주의: 서버리스 배포(Vercel 등)에서는 로컬 디스크가 유지되지 않으므로 실제 서비스에는 S3 계열을 반드시 사용하세요)
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_URL_BASE=

# ----- 지도 / 카카오채널 -----
# 실제 값은 관리자 페이지(/admin/settings)에서 입력합니다. 여기 환경변수는 필요 없습니다.
